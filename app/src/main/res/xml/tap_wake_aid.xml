<?xml version="1.0" encoding="utf-8"?>
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/nfc_tap_wake_service"
    android:requireDeviceUnlock="true">
    <!-- NFC Forum Type 4 Tag NDEF application: what a POS sends when it reads us as a tag. -->
    <aid-group android:category="other" android:description="@string/nfc_tap_wake_service">
        <aid-filter android:name="D2760000850101" />
        <!-- v1 NDEF AID: Android's reader retries with it after we refuse the v2 SELECT above. -->
        <aid-filter android:name="D2760000850100" />
    </aid-group>
</host-apdu-service>
