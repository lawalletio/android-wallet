<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the signer secret is wrapped by a non-exportable Keystore key,
     so a restored copy could never be decrypted anyway — and wallet state must not be cloned. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
