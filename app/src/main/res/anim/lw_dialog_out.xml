<?xml version="1.0" encoding="utf-8"?>
<!-- Modal exit: shrinks a touch and fades (the zoom-in on enter is animated in Compose). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_linear_in"
    android:duration="160">
    <scale android:fromXScale="1" android:toXScale="0.88" android:fromYScale="1" android:toYScale="0.88"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="1" android:toAlpha="0" />
</set>
